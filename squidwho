class Loader:
    """Loads config files into ordered Items, expanding `include`
    in place (SQ19)."""

    def __init__(self):
        self.items = []
        self.files = []          # {"path", "bytes", "lines", "included_from"}
        self.findings = []
        self.seq = 0

    def load(self, paths):
        for path in paths:
            self._load_one(path, 0, None)
        return self.items

    def _load_one(self, path, depth, included_from):
        if depth > MAX_INCLUDE_DEPTH:
            raise FatalConfig(
                "include depth exceeded (cap is %d levels, SQ19)"
                % MAX_INCLUDE_DEPTH, where=path)
        try:
            lines, nbytes = logical_lines(path)
        except (OSError, IOError) as exc:
            raise FatalConfig("cannot read config file %s: %s"
                              % (path, exc), where=path)
        self.files.append({"path": path, "bytes": nbytes,
                           "lines": len(lines),
                           "included_from": included_from})
        base_dir = os.path.dirname(os.path.abspath(path))
        for lineno, text in lines:
            tokens = tokenize(text)
            if not tokens:
                continue
            where = "%s:%d" % (path, lineno)
            directive = tokens[0].text
            if directive == "include":
                self._do_include(tokens[1:], base_dir, depth, where)
                continue
            self.items.append(Item(directive, tokens, where,
                                   self.seq, path))
            self.seq += 1

    def _do_include(self, tokens, base_dir, depth, where):
        if not tokens:
            self.findings.append(Finding(
                "SQ21", "warning",
                "include directive with no file argument", where))
            return
        for tok in tokens:
            pattern = tok.text
            if not os.path.isabs(pattern):
                self.findings.append(Finding(
                    "SQ19", "info",
                    "relative include %r resolved against the "
                    "including file's directory %s (config-directory "
                    "reading, [docs-inferred])" % (pattern, base_dir),
                    where))
                pattern = os.path.join(base_dir, pattern)
            if glob.has_magic(pattern):
                matches = sorted(glob.glob(pattern))
                if not matches:
                    raise FatalConfig(
                        "include wildcard %r matched no files (SQ19)"
                        % tok.text, where=where)
                for match in matches:
                    self._load_one(match, depth + 1, where)
            else:
                if not os.path.isfile(pattern):
                    raise FatalConfig(
                        "include file %r does not exist (SQ19)"
                        % tok.text, where=where)
                self._load_one(pattern, depth + 1, where)

