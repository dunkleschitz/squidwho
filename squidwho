# ---------------------------------------------------------------- findings

class Finding:
    """One structural finding. `fid` is a design-doc id (SQ01..SQ24)
    or "GEN" for a generic loader problem; `severity` is one of
    "finding", "warning", "info". `where` is "path:line" or None."""
    def __init__(self, fid, severity, message, where=None):
        self.fid = fid
        self.severity = severity
        self.message = message
        self.where = where

    def text(self):
        loc = " (%s)" % self.where if self.where else ""
        return "[%s] %s: %s%s" % (self.fid, self.severity, self.message, loc)

    def as_json(self):
        return {"id": self.fid, "severity": self.severity,
                "message": self.message, "where": self.where}


class FatalConfig(Exception):
    """A loader defect that ends the run (exit 2): unreadable or
    missing config, missing include, include depth exceeded."""
    def __init__(self, message, where=None):
        super().__init__(message)
        self.message = message
        self.where = where


class UsageError(Exception):
    """A CLI usage defect (exit 2)."""
    def __init__(self, message):
        super().__init__(message)
        self.message = message


# ------------------------------------------------------------- three-valued

# Kleene three-valued logic values.
TRUE = "TRUE"
FALSE = "FALSE"
UNKNOWN = "UNKNOWN"


def tri_and(vals):
    if FALSE in vals:
        return FALSE
    if UNKNOWN in vals:
        return UNKNOWN
    return TRUE


def tri_or(vals):
    if TRUE in vals:
        return TRUE
    if UNKNOWN in vals:
        return UNKNOWN
    return FALSE


def tri_not(val):
    if val == TRUE:
        return FALSE
    if val == FALSE:
        return TRUE
    return UNKNOWN


# --------------------------------------------------------------- tokenizing

class Token:
    """One config token. `quoted` records whether the token was
    written in double quotes -- a quoted ACL value names an
    external value file (SQ20), an unquoted one is a literal."""
    __slots__ = ("text", "quoted")

    def __init__(self, text, quoted=False):
        self.text = text
        self.quoted = quoted

    def __repr__(self):
        return "Token(%r, quoted=%r)" % (self.text, self.quoted)


def tokenize(line):
    """Split a config line into tokens. `#` starts a comment outside
    quotes; double (or single) quotes group one token; a `#` inside
    quotes is literal. Backslash escapes the next char inside
    quotes. [documented -- cfgman quoting + comment rules]"""
    tokens = []
    cur = []
    quoted = False
    quote = None
    i = 0
    while i < len(line):
        ch = line[i]
        if quote is not None:
            if ch == "\\" and i + 1 < len(line):
                cur.append(line[i + 1])
                i += 2
                continue
            if ch == quote:
                quote = None
                i += 1
                continue
            cur.append(ch)
            i += 1
            continue
        if ch == "#":
            break
        if ch in ("'", '"'):
            quote = ch
            quoted = True
            i += 1
            continue
        if ch.isspace():
            if cur or quoted:
                tokens.append(Token("".join(cur), quoted))
                cur = []
                quoted = False
            i += 1
            continue
        cur.append(ch)
        i += 1
    if cur or quoted:
        tokens.append(Token("".join(cur), quoted))
    return tokens


def logical_lines(path):
    """Yield (lineno, text) logical lines of a config file: physical
    lines joined on backslash-newline continuation. The line number
    reported is the first physical line of the logical line."""
    with open(path, "r", encoding="utf-8", errors="replace") as fh:
        raw = fh.read()
    phys = raw.split("\n")
    if phys and phys[-1] == "":
        phys.pop()
    out = []
    i = 0
    while i < len(phys):
        lineno = i + 1
        text = phys[i]
        while text.endswith("\\") and i + 1 < len(phys):
            text = text[:-1] + phys[i + 1]
            i += 1
        out.append((lineno, text))
        i += 1
    return out, len(raw.encode("utf-8", errors="replace"))


